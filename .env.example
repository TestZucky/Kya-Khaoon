# Copy to .env and fill in. The backend (pydantic-settings) and the frontend
# (Vite — VITE_* only) both read this one file at the repo root.
# Real shell/Docker env vars override it.

# ── Backend ──────────────────────────────────────────────────────────────────
# Postgres is the only supported database, and compose sets this for the
# containers already (host `db`, not localhost) — you only need it here to point
# at a database somewhere else. Must be a postgresql:// URL; anything else is
# rejected at startup.
# DATABASE_URL=postgresql+psycopg://kya:kya@db:5432/kya_khaoon

# Signs session tokens. MUST be a strong random value in production.
SECRET_KEY=dev-secret

# Encrypts the Swiggy tokens we hold for each user, so a database dump alone
# can't use them. Left empty it's derived from SECRET_KEY, which is fine for
# dev — set a real one in production so rotating SECRET_KEY doesn't disconnect
# every user. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put the new key first and keep the old one: new,old — the first
# encrypts, both decrypt. Drop the old one once writes have caught up.
TOKEN_ENCRYPTION_KEY=

# error | warning | info | debug
LOG_LEVEL=info

# OpenAI picks the dishes. No key → deterministic rules fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# "fake" (canned, offline) or "mcp" (real Swiggy). Connected users always get
# real Swiggy; this only sets the fallback for users who haven't connected.
SWIGGY_CLIENT=fake
SWIGGY_MCP_URL=https://mcp.swiggy.com/food

# Google Sign-In web client id (public — the backend verifies the token audience).
GOOGLE_CLIENT_ID=

# OTP delivery: "console" (logs the code, no SMS) or "twilio".
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Extra browser origins allowed to call the API, comma-separated. The frontend
# URL is always allowed; add deployed builds here.
# EXTRA_CORS_ORIGINS=https://kya-khaoon.example.com

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Set to /api to route API calls through Vite's proxy instead, keeping the
# frontend and backend on a single origin (no CORS).
VITE_API_URL=http://localhost:8000
# Same value as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
